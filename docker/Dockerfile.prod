FROM php:8.4-cli AS composer_builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libonig-dev \
    libpq-dev \
    librdkafka-dev \
    libssl-dev \
    libzip-dev \
    pkg-config \
    unzip \
    zip \
    && rm -rf /var/lib/apt/lists/*


COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

RUN docker-php-ext-install pdo pdo_pgsql zip \
    && pecl install rdkafka opentelemetry redis \
    && docker-php-ext-enable rdkafka opentelemetry redis

WORKDIR /var/www/html

COPY composer.json composer.lock ./

RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-interaction \
    --no-progress \
    --optimize-autoloader \
    --no-scripts


FROM php:8.4-cli AS production

RUN apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

COPY --from=mlocati/php-extension-installer:2.7 \
    /usr/bin/install-php-extensions \
    /usr/local/bin/install-php-extensions

RUN install-php-extensions \
    mbstring \
    opentelemetry \
    pdo_pgsql \
    rdkafka \
    redis \
    zip

WORKDIR /var/www/html

COPY --from=composer_builder --chown=www-data:www-data \
    /var/www/html/vendor ./vendor

COPY --chown=www-data:www-data . .

RUN mkdir -p \
    storage/framework/cache \
    storage/framework/sessions \
    storage/framework/views \
    bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

USER www-data

CMD ["php", "artisan", "list"]
